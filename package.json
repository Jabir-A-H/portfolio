{
  "name": "team-njs-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Statically exported editorial portfolio for Team NJS, an independent digital studio.",
  "author": "Team NJS",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "clean": "node scripts/clean.mjs",
    "start": "node scripts/serve-out.mjs",
    "lint": "eslint app components content",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/e2e/runner.mjs",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:brand": "node scripts/verify-no-hardcoded-brand.mjs",
    "verify:branding": "node scripts/verify-no-hardcoded-brand.mjs",
    "verify:all": "npm run typecheck && npm run lint && npm run clean && npm run build && npm run verify:routes && npm run verify:brand && npm run test:e2e",
    "docs:check": "node scripts/trim-docs.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
